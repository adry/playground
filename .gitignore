node_modules/
dist/
out/
.DS_Store
*.log

# Reference photography used while modelling the props. Not ours to publish.
.ref/

# Throwaway probes. Working on these props means constantly writing a script to
# measure one thing off a render and then throwing it away; they are named so
# they are easy to spot and never worth committing.
/.*.mjs
/.*.sh
/capture/_*.mjs

# Scratch harnesses. Playwright resolves node_modules from the repo root, so a
# throwaway preview page or capture script has to live here rather than in a
# tidy subdirectory. These are working files an agent writes to look at what it
# is building and deletes afterwards; they are never part of the project.
# Anchored to the root on purpose, so capture/ghost-shot.mjs and its siblings
# are untouched.
/*-lab.html
/*-lab.js
/*-shot.mjs
/*-check.mjs
/*-smoke.mjs
/*-record.mjs
/*-perf.mjs
/*-probe.mjs
/*-tmp.mjs
/dbg.mjs
/legs.html

# Agents' working directory for measurement probes. Same idea as the dotted
# scripts above: written to look at something once, never part of the project.
/.scratch/
/game-shot.mjs
/game-err.mjs
/world-shot.mjs
/page-check.mjs

# The end-to-end test's own level. editor-to-game.mjs saves the editor's real
# download here, plays it, and deletes it again, and it has to be HERE because
# public/ is the only directory the dev server hands to the game. A run that is
# interrupted leaves it behind; it is a test artifact either way and never
# something that ships. demo.json beside it is the level the site does ship.
# Anything named *-check.json: two agents have now independently written a test
# level in here, so the pattern is the rule rather than the file. demo.json is
# the one the site ships and does not match it.
/public/levels/*-check.json
